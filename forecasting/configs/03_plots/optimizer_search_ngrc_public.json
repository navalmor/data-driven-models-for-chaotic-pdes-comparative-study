{
  "experiment": {
    "run_id": "final_optimizer_search_ngrc_public",
    "type": "forecasting_visualization",
    "model": "forecasting"
  },
  "visualization": {
    "run_id": "final_optimizer_search_ngrc_public"
  },
  "inputs": {
    "optimizer_groups": [
      {
        "label": "ngrc_full64",
        "search_dirs": [
          "forecasting/data/optimizer_search/ngrc_full64"
        ]
      },
      {
        "label": "ngrc_latent8",
        "search_dirs": [
          "forecasting/data/optimizer_search/ngrc_latent8"
        ]
      }
    ]
  },
  "search_plots": {
    "enabled": true,
    "metric": "valid_relative_l2_horizon_time",
    "objective": "maximize",
    "use_lyapunov": false,
    "lambda_max": 0.043,
    "surrogate": {
      "enabled": true,
      "max_train_points": 1200,
      "random_seed": 0
    },
    "parameters": [
      {
        "name": "context_steps",
        "label": "context steps",
        "kind": "continuous",
        "scale": "linear",
        "include_in_matrix": true,
        "include_in_surrogate": true
      },
      {
        "name": "delay_spacing",
        "label": "delay spacing",
        "kind": "continuous",
        "scale": "linear",
        "include_in_matrix": true,
        "include_in_surrogate": true
      },
      {
        "name": "ridge_alpha",
        "label": "log10 ridge alpha",
        "kind": "continuous",
        "scale": "log10",
        "include_in_matrix": true,
        "include_in_surrogate": true
      },
      {
        "name": "feature_set",
        "label": "feature set",
        "kind": "categorical",
        "include_in_matrix": true,
        "include_in_surrogate": false
      },
      {
        "name": "quadratic_mode",
        "label": "quadratic mode",
        "kind": "categorical",
        "include_in_matrix": true,
        "include_in_surrogate": false
      },
      {
        "name": "include_bias",
        "label": "include bias",
        "kind": "boolean",
        "include_in_matrix": true,
        "include_in_surrogate": false
      }
    ]
  },
  "forecast_plots": {
    "enabled": false
  },
  "output": {
    "base_dir": "outputs/optimizer_search_public/ngrc",
    "formats": [
      "png"
    ],
    "dpi": 300,
    "overwrite": true
  },
  "logging": {
    "level": "INFO"
  }
}
